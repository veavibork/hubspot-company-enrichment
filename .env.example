# Copy this file to .env and fill in your values. Never commit .env.

# Access token from your HubSpot app (Distribution tab after installing it in your account)
HUBSPOT_ACCESS_TOKEN=

# Optional. Enables SEC EDGAR lookups. The SEC requires a name and contact email,
# e.g. SEC_USER_AGENT=hubspot-company-enrichment you@example.com
SEC_USER_AGENT=
